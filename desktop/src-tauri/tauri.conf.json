{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kinora",
  "version": "1.0.1",
  "identifier": "com.motionfarm.desktop",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "kinora",
        "width": 1480,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "kinora motion workspace",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzNUE0N0NFRDZGMEZGMjIKUldRaS8vRFd6a2RhODVRa3VKdmRWbGFZaTBZMFBpQlNiSkIzUXl1UjRhUGNSSGtkV1prZTV6eE0K",
      "endpoints": [
        "https://github.com/PoirotJin/kinora/releases/latest/download/latest.json"
      ]
    }
  }
}
